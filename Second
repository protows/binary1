package lesson7;
import java.util.Random;
import java.util.Scanner;
import java.util.Arrays;

public class Second {
    public static void main(String[] args) {
        Random random = new Random();
        int target = random.nextInt(100) + 1;
        System.out.println("right answer: " + target);
        int[] arr = new int[101];
        for (int i = 0; i < arr.length; i++) {
            arr[i] = i;
        }
        int ind=-1;
        Scanner s = new Scanner(System.in);
        while(true){
            System.out.println("Я загадал число. Попробуйте угадать!");
            int enter = s.nextInt();
            if (enter ==-1){
                break;
            }else if (enter == target) {
            System.out.println("Вы угадали!");
            break;
            } else if (enter < target) {
                System.out.println("Загаданное число больше (выше).");
            } else if (enter > target) {
                System.out.println("Загаданное число меньше (ниже).");
            }
            
        }
        ind = findBinary(arr, target);
        System.out.println("res: " + ind);

    }
    
    public static int findBinary(int[] arr, int target){
        int low= 0;
        int high = arr.length-1;
       
        while(low<=high){
            int middle = low + ((high-low)/2);
            if (arr[middle]==target){
                return middle;
            }else if(target<arr[middle]){
                high = middle-1;
            }else if(target>arr[middle]){
                low = middle+1;
            }
        }return -1;
    }
}
